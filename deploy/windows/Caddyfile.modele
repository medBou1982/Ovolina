# Caddy : reçoit les visiteurs et les transmet au site Ovolina (Node.js, port 4000 en local).
# Les adresses sont « :80 » (accès par l'adresse IP) ou votre domaine (HTTPS automatique) : voir lier-domaine.ps1.
__OPTIONS__

__ADRESSES__ {
	encode gzip
	request_body {
		max_size 30MB
	}
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy 127.0.0.1:4000
}
__REDIRECTION__
