# Connexion PostgreSQL
DATABASE_URL=postgres://ovolina:motdepasse@localhost:5432/ovolina

# Clé secrète pour signer les jetons de connexion (mettre une longue chaîne aléatoire)
JWT_SECRET=changez-moi-par-une-longue-chaine-aleatoire

# Port du serveur
PORT=4000

# Premier compte administrateur, créé par "npm run db:init"
ADMIN_EMAIL=admin@ovolina.com
ADMIN_PASSWORD=changez-moi
